#!/usr/bin/env python3
"""Pinned Mill launcher; local caches and inherited proxy/CA trust."""
import os
from pathlib import Path
import subprocess
import sys
from urllib.parse import urlsplit

root=Path(__file__).resolve().parent
cache=root/'tools/cache'
cache.mkdir(parents=True,exist_ok=True)
args=["-Xmx3G","-XX:ActiveProcessorCount=4",f"-Duser.home={cache}"]
for proto in ['http','https']:
    url=os.environ.get(proto.upper()+'_PROXY')
    if url:
        p=urlsplit(url)
        if p.username or p.password:raise SystemExit('Credentialed proxy requires a supported JVM authenticator')
        args += [f'-D{proto}.proxyHost={p.hostname}',f'-D{proto}.proxyPort={p.port or 80}']
if Path('/etc/ssl/certs/java/cacerts').is_file():
    args += ['-Djavax.net.ssl.trustStore=/etc/ssl/certs/java/cacerts']
env=os.environ.copy()
env['COURSIER_CACHE']=str(cache/'coursier')
env['COURSIER_REPOSITORIES']='https://repo.maven.apache.org/maven2'
env['XDG_CACHE_HOME']=str(cache/'xdg')
env['JAVA_TOOL_OPTIONS']=' '.join(filter(None,[env.get('JAVA_TOOL_OPTIONS',''),' '.join(args)]))
sys.exit(subprocess.call(['java','-cp',str(root/'tools/mill-dist'),'mill.launcher.MillLauncherMain',
                         '-i']+sys.argv[1:],cwd=root,env=env))
