read_verilog -sv /workspace/zu15-vpu/build/rtl/RamVectorFlops.sv

synth_xilinx -family xcup -top RamVectorFlops -flatten -noiopad -noclkbuf -nosrl -nowidelut
tee -o /workspace/zu15-vpu/build/synth/RamVectorFlops/stat.json stat -json
check -assert
write_json /workspace/zu15-vpu/build/synth/RamVectorFlops/mapped.json
